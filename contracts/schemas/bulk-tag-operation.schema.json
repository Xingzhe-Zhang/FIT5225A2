{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pacific-bioarchive.local/schemas/bulk-tag-operation.schema.json",
  "title": "BulkTagOperation",
  "type": "object",
  "additionalProperties": false,
  "required": ["urls", "tags", "operation"],
  "properties": {
    "urls": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^/]+/.+"}},
    "tags": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "operation": {"type": "integer", "enum": [0, 1]}
  }
}
