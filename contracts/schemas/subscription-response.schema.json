{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pacific-bioarchive.local/schemas/subscription-response.schema.json",
  "title": "SubscriptionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["subscription_id", "email", "tags", "status", "version", "created_at", "updated_at"],
  "properties": {
    "subscription_id": {"type": "string", "format": "uuid"},
    "email": {"type": "string", "format": "email", "maxLength": 254},
    "tags": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "status": {"type": "string", "enum": ["active", "pending_confirmation"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
