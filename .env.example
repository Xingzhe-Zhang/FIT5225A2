# Runtime mode. Local test-token auth is accepted only when APP_ENV=local or test.
APP_ENV=local
AWS_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=replace-user-pool-id
COGNITO_APP_CLIENT_ID=replace-public-client-id
COGNITO_OAUTH_DOMAIN=https://replace.auth.ap-southeast-2.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
API_BASE_URL=http://localhost:8000
AZURE_DATA_API_BASE_URL=http://localhost:8001
EXTERNAL_PROVIDERS=
CORS_ORIGINS=http://localhost:5173

# For local development only. Use at least 24 random characters; never reuse a cloud secret.
LOCAL_AUTH_SECRET=replace-with-random-local-only-value

# Frontend (copy only this variable to frontend/.env.local when needed).
VITE_API_BASE_URL=http://localhost:8000

# Optional local real-ML runtime. Relative paths are resolved from the project root.
LOCAL_ML_MODEL_DIR=../PacificBioArchive
LOCAL_ML_DEVICE=auto
LOCAL_ML_DETECTION_THRESHOLD=0.05
LOCAL_ML_CLASSIFICATION_THRESHOLD=0.5
